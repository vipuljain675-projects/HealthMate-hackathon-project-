# Database Configuration
# Option 1: Local SQLite (for quick dev without Supabase)
DATABASE_URL=sqlite:///./health_app.db

# Option 2: Live Supabase PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_SUPABASE_ID.supabase.co:5432/postgres

# Supabase Auth & Storage Config
SUPABASE_URL=https://YOUR_SUPABASE_ID.supabase.co
SUPABASE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
SUPABASE_JWT_SECRET=sb_secret_YOUR_SECRET_KEY

# Groq LLM Config
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
# Use qwen/qwen3.6-27b with reasoning_effort=none to suppress <think> tags
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Dev & Auth Settings (set MOCK_AUTH=false in production with real Supabase JWT)
MOCK_AUTH=true
DEFAULT_MOCK_USER_ID=demo-patient-auth-id-123

# Web Push Keys (Optional — for medicine reminder notifications)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_SUB=mailto:admin@example.com
